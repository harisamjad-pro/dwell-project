NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Ollama Cloud for explanations/refinement.
OLLAMA_LLM_URL=https://ollama.com/api
OLLAMA_API_KEY=1da67f001b7b4c3bb82fb93f148a1b10
OLLAMA_LLM_MODEL=gemma4:31b

# Ollama embedding endpoint. Default is a local Ollama daemon because the
# currently listed Ollama Cloud reasoning models are not embedding models.
# You can point this at another Ollama-compatible embedding endpoint later.
OLLAMA_EMBEDDING_URL=http://localhost:11434/api
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIMENSIONS=1024

# Protects the optional ingestion API route if you add one later.
DWELL_INGEST_SECRET=change-me
